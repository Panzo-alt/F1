header {
  background-color: #ff1801;
  color: #000000;
  padding: 10px;
  text-align: center;
  font-family: Arial, Helvetica, sans-serif;
}
  
button{
    background-color: #ff1801;
    color: #000000;
    border: none;
    padding: 10px 20px;
    cursor: pointer;
    font-family: Arial, Helvetica, sans-serif;
    font-weight: bold;
}

label {
  color: #000000;
  font-family: Arial, Helvetica, sans-serif;
  font-weight: bold;
}

body {
  background-color: #000000;
  font-family: Arial, Helvetica, sans-serif;
  color: #ff1801;
}

footer {
  background-color: #ff1801 ;
  color: #000000;
  text-align: center;
  padding: 5px;
  position: fixed;
  width: 100%;
  bottom: 0;
}